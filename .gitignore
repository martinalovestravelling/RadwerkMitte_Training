# .gitignore – Radwerk Mitte Website
# Tech-Stack ist noch offen (siehe TECHSPEC.md) – diese Datei deckt
# a) sensible Daten (Zugangsdaten, Keys, lokale Konfiguration) und
# b) typische Build-/Abhängigkeitsordner gängiger Web-Stacks ab.
# Bei Stack-Entscheidung ggf. ergänzen.

# --- Sensible Daten / Zugangsdaten ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
secrets.*
credentials.json
*_credentials.json
config.local.*
*.local.json
.npmrc
.netrc

# FTP/Deploy-Zugänge (falls WordPress o.ä. per FTP gepflegt wird)
*.ftpconfig
sftp.json
.ftppass

# Datenbank-Dumps / lokale DBs (können personenbezogene Daten enthalten)
*.sql
*.sqlite
*.sqlite3
*.db

# --- Node / JS-Tooling (falls später gewählt) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.cache/
.turbo/
.vite/
.parcel-cache/

# --- PHP / WordPress (falls relevant) ---
wp-config.php
*.sql.gz
vendor/

# --- Python (falls relevant) ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & temporäre Dateien ---
*.log
*.tmp
*.bak
*~
